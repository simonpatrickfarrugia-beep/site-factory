{
  // imn-hq: IMN HQ outreach CRM board + "Where to prospect" engine (claude/OUTREACH.md).
  // Private: Cloudflare Access in front of the workers.dev address; the Worker also checks the Access token.
  // Deploy: npx wrangler deploy --config workers/hq/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imn-hq",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  "vars": {
    // Filled in after the Cloudflare Access application exists (Zero Trust → Access → Applications).
    // Until all three are set, every request gets "locked".
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "ALLOWED_EMAILS": "simon@communityhelp.com.au,simonpatrickfarrugia@gmail.com"
  },
  // page.html is bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.html"], "fallthrough": true }]
}
