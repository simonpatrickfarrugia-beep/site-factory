{
  // health-check: IMN Website Health Check (free website check for businesses), connected to mail-tracker.
  // Deployed by .github/workflows/deploy-workers.yml (not Workers Builds), always after mail-tracker.
  // Secrets come from GitHub: ADMIN_KEY = HEALTH_CHECK_ADMIN_KEY, MT_KEY = MAIL_TRACKER_ADMIN_KEY.
  // Code: src/index.js + src/checks.js (creates its own D1 tables on first request).
  // Tests: node workers/health-check/test/run.mjs and test/integration.mjs (with mail-tracker).
  // Later: custom domain check.imnetwork.com.au via "routes" (needs the token to have Workers Routes + DNS on that zone).
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "health-check",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "health-check", "database_id": "28852ba5-7f81-440e-9a4c-0fa22ee64c7f", "migrations_dir": "migrations" }
  ],
  // The connection to Mail Tracker: Worker-to-Worker call, plus its public address for tracked links/pixels.
  "services": [{ "binding": "MAIL_TRACKER", "service": "mail-tracker" }],
  "vars": {
    "MT_PUBLIC_URL": "https://mail-tracker.simonpatrickfarrugia.workers.dev",
    "BRAND_NAME": "Independent Media Network",
    "BRAND_SHORT": "IMN",
    "BRAND_URL": "https://imnetwork.com.au",
    "BRAND_COLOR": "#1f5eff"
  },
  "observability": { "enabled": true }
  // Secrets (set by the deploy workflow, never here): ADMIN_KEY, MT_KEY
}
