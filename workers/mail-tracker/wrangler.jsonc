{
  // mail-tracker: email open/click tracker (pixel + tracked links) for emails Simon sends from Outlook.
  // Deployed by .github/workflows/deploy-workers.yml (not Workers Builds). ADMIN_KEY comes from GitHub secret MAIL_TRACKER_ADMIN_KEY.
  // Code: src/index.js (creates its own D1 tables on first request). Tests: node workers/mail-tracker/test/run.mjs
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mail-tracker",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": false,
  // go.imnetwork.com.au: tracked links + pixel for IMN emails (link domain matches the sender, better for delivery).
  // The workers.dev address keeps working for the dashboard and any snippets made there.
  "routes": [{ "pattern": "go.imnetwork.com.au", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "mail-tracker", "database_id": "43226c94-a44b-4428-afc0-af2ae214aa2c", "migrations_dir": "migrations" }
  ],
  "vars": { "SENDER_NAME": "Simon Farrugia" },
  "observability": { "enabled": true }
  // Secrets (set by the deploy workflow, never here): ADMIN_KEY
}
