{
  // Trailer pipeline for movietrailer.channel: finds new trailers, enriches them, publishes them,
  // and writes a monthly Search Console demand report.
  // Deploy: npx wrangler deploy --config workers/pipeline/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trailer-pipeline",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "kv_namespaces": [{ "binding": "STATUS", "id": "55838af4d43d4ea8957763e45d68e78e" }],
  "triggers": {
    // Times are UTC. Keep in sync with INTAKE_CRON / DAILY_CRON in src/index.ts.
    "crons": [
      // Workers Free allows 5 crons per ACCOUNT. Two here; src/index.ts (jobFor) picks the job by hour and day.
      "0 */12 * * *", // intake: every 12 hours
      "0 18-21 * * *" // daily slots: recheck (2nd), enrich (daily), catalogue (~weekly), demand (3rd), collections (4th)
    ]
  },
  "observability": { "enabled": true },
  "vars": {
    "REPO": "simonpatrickfarrugia-beep/site-factory",
    "BRANCH": "main",
    // Classic and re-release labels watched for new trailers:
    // Criterion, Kino Lorber, Vinegar Syndrome, Severin Films, Umbrella Entertainment (AU).
    // The old new-release studio list is in backups/make/TRAILER-AUTOMATIONS.md.
    "CHANNELS": "[\"UCAP57cF-FSjJKzzXg7ntPlQ\",\"UCtlPYzQ188v4gHQ5VyikNiw\",\"UCotn1stsIkEHTGv7pFSGtVA\",\"UCYhdlIRe1CbpeWrpdfr46gw\",\"UCadhU_V17tZia6mvQSYn-tg\"]",
    // Which films get published: any age, once out long enough to rent or stream. Catalogue self-refills below 50 waiting.
    "AVAILABLE_AFTER_DAYS": "90", // publish only once a film has been out 90 days (rent/stream)
    "CATALOGUE_REFILL_BELOW": "50",
    "CATALOGUE_REFILL_COUNT": "60",
    "MIN_AGE_YEARS": "0", // no age limit (changed 18 Oct); films must be rentable/streamable instead
    "ANTHROPIC_MODEL": "claude-haiku-5-5",
    "ANTHROPIC_WORKSPACE_ID": "wrkspc_01W5t4awRcfjkeb1NKxyPo8i", // Anthropic Console > Default workspace (key is not workspace-scoped)
    // Per run. Each item uses up to 3 of the 50 calls a free-plan Worker run allows.
    "ENRICH_LIMIT": "15",
    "RECHECK_LIMIT": "20",
    // Search Console property the demand report reads (Domain property).
    "GSC_SITE": "sc-domain:movietrailer.channel",
    // GA4 property the dashboard stats read (Admin > Property details). Service account is a Viewer on it.
    "GA4_PROPERTY": "553854970",
    // Dashboards refreshed by the daily stats job (/hq/stats on each site). The service account needs Viewer on each GA4 property and a user on each Search Console property.
    "STATS_SITES": "[{\"name\":\"trailers\",\"path\":\"data/trailers/stats.json\",\"ga4\":\"553854970\",\"gsc\":\"sc-domain:movietrailer.channel\"},{\"name\":\"vic\",\"path\":\"data/vic/stats.json\",\"ga4\":\"535259398\",\"gsc\":\"sc-domain:victours.com.au\"}]",
    // IndexNow is submitted by .github/workflows/indexnow.yml (Workers egress gets HTTP 429), so no INDEXNOW_KEY here.
    "SITE_HOST": "www.movietrailer.channel",
    // Catalogue builder (weekly): queue this many of the most-searched candidates per run.
    "CATALOGUE_PER_RUN": "30", // raised from 10 on 19 Oct to grow faster (enrich publishes ~10/day)
    "CATALOGUE_MIN_VOLUME": "50",
    // Google Ads location for search volumes: 2036 = Australia, 2840 = United States.
    "DATAFORSEO_LOCATION": "2840", // United States
    "DATAFORSEO_LOCATION_NAME": "United States",
    // Collections builder (monthly): new smart collection pages from the most-searched themes.
    "COLLECTIONS_PER_RUN": "3",
    "COLLECTION_MIN_FILMS": "6",
    "COLLECTION_MIN_VOLUME": "100"
  }
  // Secrets (set in the Cloudflare dashboard, never here):
  //   GITHUB_TOKEN, OMDB_API_KEY, ANTHROPIC_API_KEY, RUN_KEY
  //   YOUTUBE_API_KEY (trailer search for back-catalogue films), GSC_SERVICE_ACCOUNT (demand report)
  //   DATAFORSEO_LOGIN, DATAFORSEO_PASSWORD (search volumes for catalogue candidates)
}
