{
  // imn-mail: Email Worker for the IMN mail hub (claude/OUTREACH.md).
  // Email Routing on each hub domain sends hello@, simon@ and crm@ to this Worker.
  // Deploy: npx wrangler deploy --config workers/mail/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imn-mail",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  "vars": {
    // Must be a verified destination address in each domain's Email Routing.
    "FORWARD_TO": "simon@communityhelp.com.au",
    // Hub domains → brand. Add a line when a domain joins the hub.
    "BRAND_DOMAINS": "{\"victours.com.au\":\"vic\"}",
    // Addresses that forward to Outlook (crm@ is logged only).
    "INBOXES": "hello,simon"
  }
}
