{
  // Cloudflare Worker for the trailers brand.
  // Build:  BRAND=trailers npm run build
  // Deploy: npx wrangler deploy --config brands/trailers/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trailers",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../../dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
  // No custom domain yet. The site runs on its workers.dev preview URL until cutover.
}
