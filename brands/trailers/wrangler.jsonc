{
  // Cloudflare Worker for the trailers brand.
  // Build:  BRAND=trailers npm run build
  // Deploy: npx wrangler deploy --config brands/trailers/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "site-factory", // must match the Worker name in Cloudflare
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code (filmmaker pitches and the "original films" updates signup); everything else is the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // FORMS: filmmaker pitches → table submissions (form "pitch"); the enquiries workflow alerts Simon.
  // Updates signups use /api/subscribe → table subscribers (brand trailers, interests "films"). No emails are sent yet.
  "vars": { "BRAND": "trailers", "FORMS": "pitch" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  // Live domains. www is canonical; the bare domain is redirected to www by a Cloudflare Redirect Rule (dashboard).
  "routes": [
    { "pattern": "movietrailer.channel", "custom_domain": true },
    { "pattern": "www.movietrailer.channel", "custom_domain": true }
  ]
}
