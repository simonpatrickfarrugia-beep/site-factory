{
  // Cloudflare Worker for the trailers brand.
  // Build:  BRAND=trailers npm run build
  // Deploy: npx wrangler deploy --config brands/trailers/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "site-factory", // must match the Worker name in Cloudflare
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code ("Fund the Next Film" votes and filmmaker pitches); everything else is the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // FUND: /fund-the-next-film votes (D1 tables supporters, fund_votes, credit_ledger; migration 0003_fund.sql).
  // Voting opens once FUND_MAIL_FROM is set here AND RESEND_API_KEY is a Worker SECRET (dashboard, never the repo),
  // with the sending domain verified in Resend. Until then the vote form says "Voting opens in a few days".
  // FORMS: filmmaker pitches → table submissions (form "pitch"); the enquiries workflow alerts Simon.
  "vars": { "BRAND": "trailers", "FORMS": "pitch", "FUND": "1", "FUND_MAIL_FROM": "" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  // Live domains. www is canonical; the bare domain is redirected to www by a Cloudflare Redirect Rule (dashboard).
  "routes": [
    { "pattern": "movietrailer.channel", "custom_domain": true },
    { "pattern": "www.movietrailer.channel", "custom_domain": true }
  ]
}
