{
  // Cloudflare Worker for Trade Admin (tradeadmin.com.au). Preview on workers.dev until launch.
  // Build:  BRAND=trade-admin npm run build
  // Deploy: npx wrangler deploy --config brands/trade-admin/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "trade-admin",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../../dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Live domains (zone active in Cloudflare 25 Oct 2026). The bare domain is canonical; www should redirect to it
  // (Cloudflare Rules → Redirect Rules → "Redirect from WWW to root").
  "routes": [
    { "pattern": "tradeadmin.com.au", "custom_domain": true },
    { "pattern": "www.tradeadmin.com.au", "custom_domain": true }
  ]
}
