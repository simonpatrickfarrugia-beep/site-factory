{
  // Cloudflare Worker for Simon Says Travel (simonsaystravel.com.au): monthly Aussie travel search trends.
  // Build:  BRAND=simon-says-travel npm run build
  // Deploy: npx wrangler deploy --config brands/simon-says-travel/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "simon-says-travel",
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code (email signups, contact form); every other request is served straight from the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "BRAND": "simon-says-travel", "FORMS": "contact" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ]
  // Live domains, once simonsaystravel.com.au's DNS is on Cloudflare (bought on Wix, Nov 2026). Then add:
  // "routes": [
  //   { "pattern": "simonsaystravel.com.au", "custom_domain": true },
  //   { "pattern": "www.simonsaystravel.com.au", "custom_domain": true }
  // ]
}
