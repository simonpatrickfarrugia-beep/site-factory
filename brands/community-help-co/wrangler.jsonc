{
  // Cloudflare Worker for Community Help Co (communityhelp.com.au). Preview on workers.dev until launch.
  // Build:  BRAND=community-help-co npm run build
  // Deploy: npx wrangler deploy --config brands/community-help-co/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "community-help-co",
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code (enquiry and referral forms → D1 table submissions); everything else is the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  // JOBS: live job ads at /api/jobs (Careerjet v4 API). The Careerjet API key is a Worker SECRET named CAREERJET_KEY,
  // set in the Cloudflare dashboard (Workers → community-help-co → Settings → Variables and Secrets), never here.
  "vars": { "BRAND": "community-help-co", "FORMS": "enquiry,referral", "JOBS": "1" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  // Live domains (Microsoft 365 email records were copied into Cloudflare first, 22 Oct 2026).
  // The bare domain is canonical; www is redirected to it.
  "routes": [
    { "pattern": "communityhelp.com.au", "custom_domain": true },
    { "pattern": "www.communityhelp.com.au", "custom_domain": true }
  ]
}
