{
  // Cloudflare Worker for Community Help Co (communityhelp.com.au). Preview on workers.dev until launch.
  // Build:  BRAND=community-help-co npm run build
  // Deploy: npx wrangler deploy --config brands/community-help-co/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "community-help-co",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "../../dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
  // At launch: add routes for communityhelp.com.au (custom_domain) AFTER copying the Microsoft 365 DNS records.
}
