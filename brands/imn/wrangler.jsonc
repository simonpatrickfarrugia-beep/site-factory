{
  // Cloudflare Worker for Independent Media Network (imnetwork.com.au). Preview on workers.dev until launch.
  // Build:  BRAND=imn npm run build
  // Deploy: npx wrangler deploy --config brands/imn/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imn",
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code (get-started and contact forms → D1 table submissions); everything else is the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "BRAND": "imn", "FORMS": "start,enquiry" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ],
  // Live domains. Email on imnetwork.com.au uses MX/TXT records only, so attaching the site doesn't touch email.
  // The bare domain is canonical; www should redirect to it (Cloudflare Rules → Redirect Rules → "Redirect from WWW to root").
  "routes": [
    { "pattern": "imnetwork.com.au", "custom_domain": true },
    { "pattern": "www.imnetwork.com.au", "custom_domain": true }
  ]
}
