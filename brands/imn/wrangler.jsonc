{
  // Cloudflare Worker for Independent Media Network (imnetwork.com.au). Preview on workers.dev until launch.
  // Build:  BRAND=imn npm run build
  // Deploy: npx wrangler deploy --config brands/imn/wrangler.jsonc
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "imn",
  "compatibility_date": "2026-06-01",
  // Only /api/* runs Worker code (get-started and contact forms → D1 table submissions); everything else is the built files.
  "main": "../../src/worker/site.ts",
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  },
  "vars": { "BRAND": "imn", "FORMS": "start,enquiry" },
  "d1_databases": [
    { "binding": "DB", "database_name": "site-factory-forms", "database_id": "5441b63f-1ab8-484f-a6c7-0a0af4302774" }
  ]
  // At launch add: "routes": [{ "pattern": "imnetwork.com.au", "custom_domain": true }, { "pattern": "www.imnetwork.com.au", "custom_domain": true }]
  // (email records on imnetwork.com.au are MX/TXT only, so adding the site doesn't touch email).
}
