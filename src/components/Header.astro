---
import { brand } from '../lib/brand';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap site-header__inner">
    {brand.logo ? (
      <a class="wordmark wordmark--logo" href="/" aria-label={`${brand.name} home`}>
        <img src={brand.logo.src} alt="" width={brand.logo.width} height={brand.logo.height} />
        <span>{brand.name.toLowerCase()}</span>
      </a>
    ) : (
      <a class="wordmark" href="/" aria-label={`${brand.name} home`}>{brand.domain.replace(/^www\./, "")}</a>
    )}
    {brand.nav.length > 0 && (
      <nav aria-label="Main">
        <ul class="site-nav">
          {brand.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={current.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>
</header>
