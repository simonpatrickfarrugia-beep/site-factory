---
/**
 * The full film, for public domain films only (brands/trailers/public-domain.ts). Starts only for US visitors
 * (checked through /api/geo): the film is public domain in the US, and rules differ elsewhere.
 * Plays our own copy (/media/<slug>.mp4, R2, served to US visitors only) when we have one, otherwise the
 * Internet Archive player.
 */
import { archiveEmbed, archivePage, archiveThumb } from '../../brands/trailers/public-domain';

interface Props { archiveId: string; name: string; src?: string | null; silent?: boolean }
const { archiveId, name, src = null, silent = false } = Astro.props;
---
<div class="film-player" data-embed={archiveEmbed(archiveId)} data-src={src ?? ''} data-poster={archiveThumb(archiveId)} data-page={archivePage(archiveId)} data-name={name} data-silent={silent ? '1' : ''}>
  <div class="film-player__frame">
    <img src={archiveThumb(archiveId)} alt="" width="640" height="480" fetchpriority="high" />
    <button type="button" class="film-player__play" hidden>
      <span class="film-player__icon" aria-hidden="true"></span>
      <span>Play the full film free</span>
      {silent && <span class="film-player__sub">Silent film: plays without sound</span>}
    </button>
    <p class="film-player__note">Checking where you're watching from…</p>
  </div>
  <noscript><p class="film-player__fallback">The player needs JavaScript. You can also find this film on the <a href={archivePage(archiveId)} rel="noopener">Internet Archive</a>.</p></noscript>
</div>

<style>
  .film-player { background: #000; }
  .film-player__frame { position: relative; width: min(100%, 68rem); margin-inline: auto; aspect-ratio: 4 / 3; max-height: 78vh; background: #000; }
  .film-player__frame img { width: 100%; height: 100%; object-fit: contain; opacity: 0.55; }
  .film-player__sub { font-weight: 400; font-size: 0.9rem; opacity: 0.85; }
  .film-player__frame video { position: absolute; inset: 0; width: 100%; height: 100%; background: #000; }
  .film-player__frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .film-player__play { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.75rem; width: 100%; border: 0; background: transparent; color: #fff; font: inherit; font-weight: 700; cursor: pointer; }
  .film-player__icon { width: 4.5rem; height: 4.5rem; border-radius: 50%; background: var(--color-accent, #F2B53A); position: relative; }
  .film-player__icon::after { content: ''; position: absolute; left: 1.75rem; top: 1.3rem; border-style: solid; border-width: 0.95rem 0 0.95rem 1.5rem; border-color: transparent transparent transparent #12162B; }
  .film-player__note { position: absolute; left: 1rem; right: 1rem; bottom: 1rem; margin: 0; padding: 0.75rem 1rem; border-radius: 0.5rem; background: rgba(0, 0, 0, 0.78); color: #fff; font-size: 0.95rem; }
  .film-player__note a { color: var(--color-accent, #F2B53A); }
  .film-player__fallback { color: #fff; text-align: center; padding: 1rem; margin: 0; }
  .film-player__fallback a { color: var(--color-accent, #F2B53A); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.film-player').forEach((box) => {
    const frame = box.querySelector<HTMLElement>('.film-player__frame');
    const play = box.querySelector<HTMLButtonElement>('.film-player__play');
    const note = box.querySelector<HTMLElement>('.film-player__note');
    const blocked = () => {
      if (note) note.innerHTML = `This film is public domain in the United States. Copyright rules are different in other countries, so we only play it for US visitors. <a href="${box.dataset.page}" rel="noopener">See it on the Internet Archive</a>.`;
    };
    fetch('/api/geo', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : null))
      .then((d: { country?: string } | null) => {
        if (d?.country !== 'US' || !play) return blocked();
        note?.remove();
        play.hidden = false;
        play.setAttribute('aria-label', `Play ${box.dataset.name ?? 'the film'}, full movie`);
        play.addEventListener('click', () => {
          let el: HTMLElement;
          if (box.dataset.src) {
            const v = document.createElement('video');
            v.src = box.dataset.src;
            v.poster = box.dataset.poster ?? '';
            v.controls = true;
            v.autoplay = true;
            v.playsInline = true;
            v.preload = 'metadata';
            v.setAttribute('aria-label', `${box.dataset.name ?? 'Film'}, full movie`);
            el = v;
          } else {
            const iframe = document.createElement('iframe');
            iframe.src = box.dataset.embed ?? '';
            iframe.title = box.dataset.name ?? 'Film';
            iframe.allow = 'fullscreen; picture-in-picture';
            iframe.allowFullscreen = true;
            el = iframe;
          }
          frame?.replaceChildren(el);
          (window as unknown as { gtag?: (...a: unknown[]) => void }).gtag?.('event', 'watch_free', { film: box.dataset.name });
        });
      })
      .catch(blocked);
  });
</script>
