---
/** Email list signup (posts to /api/subscribe on the same site). Works without JavaScript too. */
interface Props { heading?: string; text?: string; source?: string }
const {
  heading = 'New day trips in your inbox',
  text = 'About once a month: new plans, plus what’s on in the season (autumn colour, wildflowers, whale season). No spam, unsubscribe any time.',
  source = Astro.url.pathname,
} = Astro.props;
---
<section class="signup" id="signup" aria-labelledby="signup-h">
  <h2 id="signup-h" class="signup__h">{heading}</h2>
  <p class="signup__text">{text}</p>
  <form class="signup__form" method="post" action="/api/subscribe" data-signup>
    <label class="signup__label" for="signup-email">Email address</label>
    <div class="signup__row">
      <input id="signup-email" name="email" type="email" autocomplete="email" inputmode="email" required placeholder="you@example.com" />
      <button type="submit" data-cta="signup">Send me day trips</button>
    </div>
    <input type="hidden" name="source" value={source} />
    <div class="signup__hp" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
    <p class="signup__msg" role="status" aria-live="polite"></p>
    <p class="signup__fine">We only use your email for Vic Tours emails. <a href="/privacy-policy">Privacy</a>.</p>
  </form>
</section>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    const msg = form.querySelector<HTMLElement>('.signup__msg')!;
    const q = new URLSearchParams(location.search).get('subscribed');
    if (q !== null) msg.textContent = q === '1' ? "You're on the list. Thanks!" : 'That didn’t work. Check the address and try again.';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      btn.disabled = true; msg.textContent = 'Adding you…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const out = await res.json();
        msg.textContent = out.message;
        if (out.ok) {
          form.querySelector<HTMLInputElement>('input[type=email]')!.value = '';
          (window as any).gtag?.('event', 'sign_up', { method: 'email', page: location.pathname });
        }
      } catch {
        msg.textContent = 'That didn’t work. Please try again.';
      }
      btn.disabled = false;
    });
  }
</script>
<style>
  .signup { margin: var(--space-6) 0 var(--space-4); padding: var(--space-4); border-radius: 14px; background: var(--sign-green, #0a6b3d); color: #fff; }
  .signup__h { margin: 0 0 0.4rem; font-size: 1.5rem; color: #fff; }
  .signup__text { margin: 0 0 var(--space-3); max-width: 36rem; opacity: 0.95; }
  .signup__label { display: block; font-weight: 700; font-size: 0.9rem; margin-bottom: 0.3rem; }
  .signup__row { display: flex; flex-wrap: wrap; gap: 0.5rem; max-width: 34rem; }
  .signup__row input { flex: 1 1 14rem; min-width: 0; font: inherit; padding: 0.75rem 0.9rem; border-radius: 10px; border: 2px solid #fff; background: #fff; color: #17201b; }
  .signup__row button { flex: 0 0 auto; font: inherit; font-family: var(--font-display); font-weight: 800; padding: 0.75rem 1.1rem; border-radius: 10px; border: 2px solid #fff; background: #f2c230; color: #17201b; cursor: pointer; }
  .signup__row button:disabled { opacity: 0.6; }
  .signup__row button:focus-visible, .signup__row input:focus-visible { outline: 3px solid #f2c230; outline-offset: 2px; }
  .signup__msg { min-height: 1.3em; margin: 0.5rem 0 0; font-weight: 700; }
  .signup__fine { margin: 0.2rem 0 0; font-size: 0.8rem; opacity: 0.9; }
  .signup__fine a { color: #fff; }
  .signup__hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
</style>
