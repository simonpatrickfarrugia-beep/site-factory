---
/** Home page strip above the fold: "We're funding our first film. Vote on what gets made →".
 *  The leading film and the vote total appear only once 25+ votes are confirmed (/api/fund/counts). */
---
<a class="fund-banner" href="/fund-the-next-film" data-cta="fund_banner">
  <span class="wrap fund-banner__inner">
    <span class="fund-banner__badge">New</span>
    <span class="fund-banner__text">We’re funding our first film. <strong>Vote on what gets made →</strong></span>
    <span class="fund-banner__live" data-fund-live hidden></span>
  </span>
</a>
<script is:inline>
  fetch('/api/fund/counts', { headers: { accept: 'application/json' } })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (d) {
      if (!d || !d.ok || !d.show || !d.leader) return;
      var el = document.querySelector('[data-fund-live]');
      el.textContent = 'Leading: ' + d.leader.name + ' · ' + d.total.toLocaleString() + ' votes';
      el.hidden = false;
    })
    .catch(function () {});
</script>
