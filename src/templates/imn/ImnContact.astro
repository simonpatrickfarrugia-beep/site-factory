---
import ImnFormScript from './ImnFormScript.astro';
import ImnFaq from './ImnFaq.astro';
import type { FormPage, SiteInfo } from '../../../brands/imn/model';
interface Props { site: SiteInfo; page: FormPage }
const { site, page: p } = Astro.props;
const faq = (p.faqQs ?? []).map((q) => site.faq.find((f) => f.q === q)).filter((f) => f !== undefined);
---
<section class="imn-pagehead">
  <div class="imn-wrap">
    <h1>{p.title}</h1>
    <p class="imn-lede">{p.lede}</p>
  </div>
</section>
<div class="imn-wrap imn-section imn-split">
  <form class="imn-form" data-form action={`${site.formsEndpoint}/submit/enquiry`} method="post">
    <div class="imn-row">
      <label>Your name<input name="name" autocomplete="name" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
    </div>
    <label>Your question<textarea name="message" rows="5" required></textarea></label>
    <input class="imn-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="imn-btn imn-btn--coin" type="submit">Send</button>
    <p class="imn-form__status" role="status" aria-live="polite"></p>
  </form>
  <div class="imn-contact">
    <h2>Email</h2>
    <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    <h2>Based in</h2>
    <p>Melbourne, working with businesses across Australia by email, phone or video call.</p>
    <h2>Ready to go?</h2>
    <p><a href="/get-started">Tell us about your business</a> and we'll build your preview.</p>
  </div>
</div>
{(p.sections?.length || faq.length > 0) && (
  <div class="imn-wrap imn-section imn-prose">
    {p.sections?.map((s) => (<><h2>{s.h}</h2>{s.p.map((t) => <p>{t}</p>)}</>))}
    {faq.length > 0 && (<><h2>Before you write</h2><ImnFaq faq={faq} /></>)}
  </div>
)}
<ImnFormScript email={site.email} />
