---
/** The single plan card (pricing page and home). */
import type { SiteInfo } from '../../../brands/imn/model';
interface Props { site: SiteInfo }
const { site } = Astro.props;
---
<div class="imn-plan">
  {site.setup.promo && <p class="imn-plan__flag">{site.setup.promoLabel}: no setup fee</p>}
  <h3 class="imn-plan__name">The website plan</h3>
  <p class="imn-plan__price"><strong>${site.price.monthly}</strong> a month <span>+ GST</span></p>
  <p class="imn-plan__bill">${site.price.monthlyIncGst.toFixed(2)} a month including GST, charged by card.</p>
  <ul class="imn-ticks">
    {site.included.map((i) => <li>{i.t}</li>)}
  </ul>
  <dl class="imn-plan__extras">
    <div><dt>Setup</dt><dd>{site.setup.normal ? <>${site.setup.normal} + GST, once.</> : <>$0. Building your site is part of the plan.</>}{site.setup.promo && <> <strong>Founding offer:</strong> no setup fee for our first {site.setup.promoSpots} clients on a {site.setup.promoTerm}-month plan.</>}</dd></div>
    <div><dt>Change rounds</dt><dd>{site.includedChanges} a month, up to {site.changeCapMinutes} minutes each. Extra rounds ${site.extraChange} + GST.</dd></div>
    <div><dt>Contract</dt><dd>None. Month to month, cancel any time{site.setup.promo && <> ({site.setup.promoTerm} months on the founding offer)</>}. <a href="/terms">Our terms</a>.</dd></div>
  </dl>
  {site.guarantee && <div class="imn-guar"><b>🛡️ {site.guarantee.title}</b><ul>{site.guarantee.points.map((g) => <li>{g}</li>)}</ul></div>}
  <a class="imn-btn imn-btn--coin imn-btn--block" href="/get-started" data-cta="start_plan">Start with a free website</a>
</div>
