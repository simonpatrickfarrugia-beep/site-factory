---
/** Contact form: posts to /api/submit/contact (stored in D1 `submissions`; the enquiries workflow tells Simon). */
import Prose from './Prose.astro';
interface Props { page: { h1: string; paragraphs: string[] } }
const { page } = Astro.props;
---
<div class="sst-wrap sst-section sst-measure">
  <h1 class="sst-h1">{page.h1}</h1>
  <Prose paragraphs={page.paragraphs} />
  <form class="contact" id="contact" method="post" action="/api/submit/contact" data-contact>
    <label for="c-name">Your name</label>
    <input id="c-name" name="name" autocomplete="name" required maxlength="120" />
    <label for="c-email">Email address</label>
    <input id="c-email" name="email" type="email" autocomplete="email" required />
    <label for="c-msg">Message</label>
    <textarea id="c-msg" name="message" rows="6" required maxlength="4000"></textarea>
    <div class="ticket__hp" aria-hidden="true"><label>Leave this empty <input name="company_website" tabindex="-1" autocomplete="off" /></label></div>
    <button class="sst-btn" type="submit" data-cta="contact">Send message</button>
    <p class="contact__msg" role="status" aria-live="polite"></p>
  </form>
</div>
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  if (form) {
    const msg = form.querySelector<HTMLElement>('.contact__msg')!;
    const q = new URLSearchParams(location.search).get('sent');
    if (q !== null) msg.textContent = q === '1' ? 'Sent. Thanks, I’ll reply by email.' : 'That didn’t work. Check your email address and try again.';
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button')!;
      btn.disabled = true; msg.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } });
        const out = await res.json();
        msg.textContent = out.ok ? 'Sent. Thanks, I’ll reply by email.' : out.message;
        if (out.ok) form.reset();
      } catch { msg.textContent = 'That didn’t work. Please try again.'; }
      btn.disabled = false;
    });
  }
</script>
