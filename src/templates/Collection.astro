---
import TrailerScreen from '../components/TrailerScreen.astro';
import type { Movie } from '../../brands/trailers/model';

interface Props {
  heading: string;
  tagline: string | null;
  introHtml: string | null;
  movies: Movie[];
  backTo?: { href: string; label: string };
  amazonTag?: string;
}
const { heading, tagline, introHtml, movies, backTo, amazonTag } = Astro.props;
// Where to watch, right on the list: Prime Video rental link per film (same rules as the movie page).
const primeUrl = (m: Movie) => {
  if (!amazonTag) return null;
  if (m.rentBuyUrl) {
    try { const u = new URL(m.rentBuyUrl); if (/(^|\.)amazon\./i.test(u.hostname)) { u.searchParams.set('tag', amazonTag); return u.toString(); } } catch { /* fall through */ }
  }
  return `https://www.amazon.com/s?k=${encodeURIComponent(m.year ? `${m.name} ${m.year}` : m.name)}&i=instant-video&tag=${amazonTag}`;
};
---
<div class="wrap collection">
  <header class="page-head">
    {backTo && <p class="crumb"><a href={backTo.href}>{backTo.label}</a></p>}
    <h1 class="display">{heading}</h1>
    {tagline && <p class="page-head__lede">{tagline}</p>}
    {introHtml && <div class="prose page-head__intro" set:html={introHtml} />}
    <p class="page-head__meta">{movies.length} {movies.length === 1 ? 'trailer' : 'trailers'}</p>
  </header>

  <ol class="lineup">
    {movies.map((m) => (
      <li class="lineup__item">
        <div class="lineup__screen">
          <TrailerScreen youtubeId={m.youtubeId} title={m.name} />
        </div>
        <div class="lineup__text">
          <h2 class="lineup__title"><a href={`/movies/${m.slug}`}>{m.name}</a></h2>
          <p class="lineup__meta">
            {[m.year, m.rating, m.genres.slice(0, 2).join(', ')].filter(Boolean).join(', ')}
          </p>
          {(m.tagline || m.synopsis) && <p class="lineup__blurb">{m.tagline ?? m.synopsis}</p>}
          <p class="lineup__watch">
            {primeUrl(m) && <a class="button button--small" href={primeUrl(m)!} rel="sponsored noopener" target="_blank" data-cta="prime">Rent on Prime Video</a>}
            <a class="text-link" href={`/movies/${m.slug}`}>All ways to watch {m.name}</a>
          </p>
        </div>
      </li>
    ))}
  </ol>
</div>
