---
import SlCta from './SlCta.astro';
import type { Category, SiteInfo, Step } from '../../../brands/shortlisted/model';
interface Props { email: string; hero: SiteInfo['hero']; steps: Step[]; categories: Category[] }
const { hero, steps, categories } = Astro.props;
---
<section class="sl-hero">
  <div class="sl-wrap sl-hero__grid">
    <div>
      <h1>{hero.title}</h1>
      <p class="sl-lede">{hero.lede}</p>
      <p class="sl-actions">
        <a class="sl-btn" href="/get-a-shortlist" data-cta="shortlist_hero">Get a free shortlist</a>
        <a class="sl-link" href="/business-travel/travel-policy-template">Or make a free travel policy</a>
      </p>
    </div>
    <figure class="sl-pad" aria-label="Example shortlist">
      <figcaption class="sl-pad__head">{hero.card.heading}</figcaption>
      <ol class="sl-pad__rows">
        {hero.card.rows.map((r) => (
          <li class={`sl-pad__row sl-pad__row--${r.s}`}>
            <span class="sl-pad__t">{r.t}</span>
            <span class="sl-pad__why">{r.why}</span>
            {r.s === 'pick' && (
              <svg class="sl-pad__circle" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
                <path pathLength="100" d="M30 70 C 20 25, 160 8, 260 14 C 360 20, 392 48, 380 78 C 368 108, 230 116, 130 110 C 50 105, 8 92, 22 58 C 30 40, 60 30, 96 24" />
              </svg>
            )}
          </li>
        ))}
      </ol>
    </figure>
  </div>
</section>

<section class="sl-wrap sl-section">
  <h2 class="sl-h2">How it works</h2>
  <ol class="sl-steps">
    {steps.map((s) => <li><h3>{s.t}</h3><p>{s.d}</p></li>)}
  </ol>
</section>

<section class="sl-band">
  <div class="sl-wrap sl-section">
    <h2 class="sl-h2">What we can help with</h2>
    {categories.map((c) => (
      <div class="sl-cat">
        <h3><a href={`/${c.slug}`}>{c.name}</a></h3>
        <p>{c.d}</p>
        <p class="sl-cat__links"><a href={`/${c.slug}`}>Read the guide</a> <a href="/business-travel/travel-policy-template">Free travel policy template</a></p>
      </div>
    ))}
    <p class="sl-small">More categories are on the way. Shopping for something else? <a href="/get-a-shortlist">Tell us</a>: it's how we decide what to add next.</p>
  </div>
</section>

<section class="sl-wrap sl-section sl-section--tight">
  <h2 class="sl-h2">Free, and upfront about it</h2>
  <p class="sl-measure">Shortlisted costs businesses nothing. Providers may pay us when we introduce a new customer, and we tell you whenever a provider we suggest is one we're connected to. <a href="/how-we-make-money">How we make money</a>.</p>
</section>

<SlCta />
