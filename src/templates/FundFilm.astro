---
/**
 * /fund-the-next-film: vote on the first film we help fund (double opt-in, D1) and a filmmaker pitch form.
 * No affiliate links on this page (rule, 31 Oct 2026). Live counts come from /api/fund/counts and stay hidden
 * until 25 confirmed votes. Wording is deliberately careful: nothing is funded yet, no money is raised from
 * visitors, and credits have no cash value.
 */
interface Concept { id: string; name: string; blurb: string; tag: string }
interface Props { concepts: Concept[]; faqs: { q: string; a: string }[] }
const { concepts, faqs } = Astro.props;
---
<section class="fund-hero">
  <div class="wrap">
    <p class="fund-kicker">Fund the next film</p>
    <h1 class="display">Help us fund our first film.</h1>
    <p class="lede fund-hero__lede">We plan to set aside a share of what this site earns from ads and affiliate links to help fund original short films, and supporters vote on what gets made first.</p>
    <p class="fund-status"><strong>Where we’re at:</strong> nothing has been funded yet. This first vote tells us which film to back first. Voting is free.</p>
  </div>
</section>

<div class="wrap">
  <section class="band" id="vote" aria-labelledby="vote-title">
    <div class="band__head">
      <h2 id="vote-title">Pick the first film</h2>
      <p class="fund-total" data-fund-total>Be one of the first to vote.</p>
    </div>
    <p class="fund-confirmed" data-fund-confirmed hidden role="status">Your vote is confirmed. Thanks for being a Founding Supporter!</p>

    <form class="fund-form" data-fund-vote action="/api/fund/vote" method="post">
      <fieldset class="fund-cards">
        <legend class="visually-hidden">Choose one film</legend>
        {concepts.map((c, i) => (
          <label class={`fund-card fund-card--${i + 1}`}>
            <input type="radio" name="concept" value={c.id} required />
            <span class="fund-card__tag">{c.tag}</span>
            <span class="fund-card__name">{c.name}</span>
            <span class="fund-card__blurb">{c.blurb}</span>
            <span class="fund-bar" data-bar={c.id} hidden><span class="fund-bar__fill"></span><span class="fund-bar__pct"></span></span>
          </label>
        ))}
      </fieldset>

      <div class="fund-form__fields">
        <label class="fund-field">Your email<input name="email" type="email" autocomplete="email" required /></label>
        <label class="fund-check"><input type="checkbox" name="consent" value="yes" /> Send me funding updates <span class="fund-opt">(optional)</span></label>
        <input class="fund-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button" type="submit">Vote</button>
        <p class="fund-form__status" role="status" aria-live="polite"></p>
        <p class="fund-fine">We’ll email you a link to confirm your vote; it only counts once you do. One vote per email. Confirmed voters become Founding Supporters and get 10 credits. Credits have no cash value and can’t be exchanged for money; we’ll explain what they’re for before they can be used. See our <a href="/privacy-policy">privacy policy</a>.</p>
      </div>
    </form>
  </section>

  <section class="band" aria-labelledby="pitch-title" id="pitch">
    <div class="fund-pitch">
      <div>
        <h2 id="pitch-title">Filmmakers: pitch us</h2>
        <p>Making a short film that fits? Tell us about it. We read every pitch, but can’t reply to them all.</p>
        <p class="fund-fine">Send only what you’re happy to share: a logline and a link, not a script. We may already be developing similar ideas, and sending a pitch doesn’t create any agreement or obligation on either side.</p>
      </div>
      <form class="fund-form fund-form--pitch" data-fund-pitch action="/api/submit/pitch" method="post">
        <label class="fund-field">Your name<input name="name" autocomplete="name" required maxlength="120" /></label>
        <label class="fund-field">Email<input name="email" type="email" autocomplete="email" required /></label>
        <label class="fund-field">Project title<input name="project_title" required maxlength="160" /></label>
        <label class="fund-field">Logline <span class="fund-opt">(one or two sentences)</span><textarea name="logline" rows="3" required maxlength="400"></textarea></label>
        <label class="fund-field">Link to your reel or past work<input name="reel_link" type="url" placeholder="https://" required maxlength="500" /></label>
        <input class="fund-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="button" type="submit">Send pitch</button>
        <p class="fund-form__status" role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="band prose" aria-labelledby="faq-title">
    <h2 id="faq-title">Questions</h2>
    {faqs.map((f) => (<><h3 class="fund-q">{f.q}</h3><p>{f.a}</p></>))}
  </section>
</div>

<script is:inline>
  (function () {
    var track = function (name) { if (window.gtag) window.gtag('event', name); };
    var params = new URLSearchParams(location.search);
    var confirmed = params.get('confirmed');
    if (confirmed) {
      var note = document.querySelector('[data-fund-confirmed]');
      if (confirmed === 'already') note.textContent = 'Your vote was already confirmed. Thanks for being a Founding Supporter!';
      note.hidden = false;
      if (confirmed === '1') track('fund_vote_confirmed');
      history.replaceState(null, '', location.pathname + '#vote');
    }

    fetch('/api/fund/counts', { headers: { accept: 'application/json' } })
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d || !d.ok || !d.show) return;
        document.querySelector('[data-fund-total]').textContent = d.total.toLocaleString() + ' confirmed votes so far';
        document.querySelectorAll('[data-bar]').forEach(function (bar) {
          var pct = Math.round((d.counts[bar.getAttribute('data-bar')] || 0) * 100 / d.total);
          bar.querySelector('.fund-bar__fill').style.width = pct + '%';
          bar.querySelector('.fund-bar__pct').textContent = pct + '%';
          bar.hidden = false;
        });
      })
      .catch(function () {});

    function wire(form, event, okText) {
      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var status = form.querySelector('.fund-form__status');
        var button = form.querySelector('button[type=submit]');
        button.disabled = true;
        status.textContent = 'Sending…';
        fetch(form.action, { method: 'POST', body: new FormData(form), headers: { accept: 'application/json' } })
          .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
          .then(function (d) {
            if (!d.ok) { status.textContent = d.message || "That didn't send. Please try again."; return; }
            status.textContent = okText || d.message;
            form.reset();
            track(event);
          })
          .catch(function () { status.textContent = "That didn't send. Please try again."; })
          .finally(function () { button.disabled = false; });
      });
    }
    wire(document.querySelector('[data-fund-vote]'), 'fund_vote_submitted');
    wire(document.querySelector('[data-fund-pitch]'), 'pitch_submitted', 'Pitch sent. Thanks! We’ll be in touch if it’s a fit.');
  })();
</script>
