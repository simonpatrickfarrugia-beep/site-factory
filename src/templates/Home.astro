---
import ChannelStream from '../components/ChannelStream.astro';
import MovieCard from '../components/MovieCard.astro';
import CollectionCard from '../components/CollectionCard.astro';

type Card = { slug: string; name: string; year: string | null; youtubeId: string };
interface Props {
  stream: { slug: string; name: string; youtubeId: string }[];
  latest: Card[];
  featured: { slug: string; name: string; tagline: string | null; count: number; youtubeId: string | null }[];
  totals: { movies: number; collections: number };
  allSlugs: string[];
}
const { stream, latest, featured, totals, allSlugs } = Astro.props;
---
<section class="spotlight" aria-labelledby="home-title">
  <div class="wrap spotlight__inner">
    <div class="spotlight__text">
      <h1 id="home-title" class="display">Find your next movie to watch</h1>
      <p class="spotlight__blurb">
        Classic films worth a rewatch: see the trailer, then find where to rent or stream it tonight. Or let the free trailer channel play, 24/7.
      </p>
      <form class="search" action="/browse" method="get" role="search">
        <label class="visually-hidden" for="home-search">Search trailers</label>
        <input id="home-search" type="search" name="q" placeholder={`Search ${totals.movies} trailers`} autocomplete="off" />
        <button class="button" type="submit">Search</button>
      </form>
    </div>
    <div class="spotlight__screen">
      <ChannelStream items={stream} poster={latest[0] ?? stream[0]} />
    </div>
  </div>
</section>

<div class="wrap">
  <section class="band" aria-labelledby="latest">
    <div class="band__head">
      <h2 id="latest">Recently added</h2>
      <a class="text-link" href="/browse">Browse all trailers</a>
    </div>
    <div class="grid grid--cards">
      {latest.map((m) => <MovieCard {...m} />)}
    </div>
  </section>

  {featured.length > 0 && (
    <section class="band" aria-labelledby="collections">
      <div class="band__head">
        <h2 id="collections">Trending collections</h2>
        <a class="text-link" href="/discover">See all {totals.collections} collections</a>
      </div>
      <div class="grid grid--collections">
        {featured.map((c) => <CollectionCard {...c} />)}
      </div>
    </section>
  )}

  <section class="band split" aria-label="More ways in">
    <div class="split__panel">
      <h2>Can't decide?</h2>
      <p>We'll pick a trailer from the catalog at random.</p>
      <p><a class="button" href="/browse" data-surprise={JSON.stringify(allSlugs)}>Surprise me</a></p>
    </div>
    <div class="split__panel split__panel--accent">
      <h2>Got a film? Get featured.</h2>
      <p>Submit your trailer for a spot in our catalog and 24/7 stream rotation. Free listings available — plus promoted placements and revenue-share deals for indie filmmakers.</p>
      <p><a class="button button--ink" href="mailto:hello@movietrailer.channel?subject=Trailer%20Submission">Submit your trailer</a></p>
    </div>
  </section>
</div>

<script>
  const link = document.querySelector<HTMLAnchorElement>('[data-surprise]');
  link?.addEventListener('click', (e) => {
    const slugs = JSON.parse(link.dataset.surprise ?? '[]') as string[];
    if (!slugs.length) return;
    e.preventDefault();
    location.href = `/movies/${slugs[Math.floor(Math.random() * slugs.length)]}`;
  });
</script>
