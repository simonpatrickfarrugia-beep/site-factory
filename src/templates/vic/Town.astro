---
import RoadSign from '../../components/vic/RoadSign.astro';
import PlaceRow from '../../components/vic/PlaceRow.astro';
import AffiliateLink from '../../components/vic/AffiliateLink.astro';
import PhotoFig from '../../components/vic/Photo.astro';
import MiniMap from '../../components/vic/MiniMap.astro';
import { GROUP_LABEL, type Group, type Place } from '../../../brands/vic/model';
interface Props {
  town: { name: string; slug: string; km: number; region: string; intro: string; tips: string[]; centre?: [number, number] | null };
  sections: { group: Group; total: number; places: Place[] }[];
  nearby: { slug: string; name: string; km: number }[];
  collections: { href: string; name: string }[];
  affiliates?: Record<string, any> | null;
  photo?: any;
  placePhotos?: Record<string, any>;
  /** Region hubs: extra guide paragraphs, member towns, town label on each place. */
  body?: string[];
  members?: { slug: string; name: string; km: number }[];
  townNames?: Record<string, string>;
  isRegion?: boolean;
  /** Ready-made plans for this town (day trip, weekends, road trips): shown first. */
  plans?: { href: string; kind: string; title: string; line: string; photo?: { url?: string; width?: number; height?: number } | null }[];
  tripBuilder?: string | null;
}
const { town, sections, nearby, collections, affiliates = null, photo = null, placePhotos = {}, body = [], members = [], townNames = {}, isRegion = false, plans = [], tripBuilder = null } = Astro.props;
---
<div class="wrap town">
  <p class="crumb"><a href="/towns">All towns</a></p>
  <RoadSign name={town.name} km={town.km} size="hero" as="h1" sub={isRegion ? `${members.length} towns · from ${town.km} km from Melbourne` : town.km < 3 ? `${town.region}, central Melbourne` : `${town.region}, ${town.km} km from Melbourne`} />
  {photo && <PhotoFig photo={photo} alt={`${town.name}, Victoria`} />}
  <div class="town__intro">
    <p class="town__lede">{town.intro}</p>
    {body.map((para) => <p class="town__body">{para}</p>)}
    {town.tips.map((tip) => <p class="tip"><strong>Local tip:</strong> {tip}</p>)}
  </div>
  {(plans.length > 0 || tripBuilder) && (
    <section class="plans" aria-labelledby="plans-h">
      <h2 id="plans-h">{plans.length ? `Ready-made plans for ${town.name}` : `Plan a trip to ${town.name}`}</h2>
      {plans.length > 0 && (
        <ul class="plans__list">
          {plans.map((p) => (
            <li>
              <a class="plan" href={p.href} data-cta="town_plan">
                {p.photo?.url ? <img class="plan__img" src={p.photo.url} alt="" width="96" height="96" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <span class="plan__img plan__img--none" aria-hidden="true" />}
                <span class="plan__text">
                  <span class="plan__kind">{p.kind}</span>
                  <strong class="plan__title">{p.title}</strong>
                  {p.line && <span class="plan__line">{p.line}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
      {tripBuilder && <p class="plans__tb"><a href={tripBuilder} data-cta="town_tripbuilder">{plans.length ? 'Or build your own trip: who, how long, car or train →' : 'Build a day trip or weekend: tell us who, how long, car or train →'}</a></p>}
    </section>
  )}

  {town.centre && town.km >= 15 && <MiniMap name={town.name} lat={town.centre[0]} lon={town.centre[1]} km={isRegion ? null : town.km} />}

  {members.length > 0 && (
    <section class="town__section">
      <h2>Towns in the {town.name}</h2>
      <ul class="signpost">{members.map((t) => <li><RoadSign name={t.name} km={t.km} href={`/${t.slug}`} /></li>)}</ul>
    </section>
  )}

  <nav class="jump" aria-label="On this page">
    {sections.map((s) => <a class={`jump__chip jump__chip--${s.group}`} href={`#${s.group}`}>{GROUP_LABEL[s.group].short} <span>{s.total}</span></a>)}
  </nav>

  {sections.map((s) => (
    <section class="town__section" id={s.group}>
      <h2 class={`section-head section-head--${s.group}`}>{GROUP_LABEL[s.group].title(town.name)}</h2>
      {s.group === 'stay' && <AffiliateLink aff={affiliates?.stay} place={town.name} kind="stay" />}
      {s.group === 'do' && <AffiliateLink aff={affiliates?.tours} place={town.name} kind="tours" />}
      {s.total === 0 ? (
        <p class="empty">No {GROUP_LABEL[s.group].noun} listed yet.</p>
      ) : (
        <>
          <ul class="places">{s.places.map((p) => <PlaceRow place={p} photo={placePhotos[p.id]} townName={townNames[p.town]} townSlug={p.town} />)}</ul>
          {s.total > s.places.length && (
            <p class="more"><a href={`/${town.slug}/${s.group}`}>See all {s.total} {GROUP_LABEL[s.group].noun} in {town.name}</a></p>
          )}
        </>
      )}
    </section>
  ))}

  {collections.length > 0 && (
    <section class="town__section">
      <h2>Trip ideas</h2>
      <ul class="inline-list">{collections.map((c) => <li><a href={c.href}>{c.name}</a></li>)}</ul>
    </section>
  )}

  {nearby.length > 0 && (
    <section class="town__section">
      <h2>{isRegion ? 'Nearby regions and towns' : 'Nearby on the list'}</h2>
      <ul class="signpost">{nearby.map((t) => <li><RoadSign name={t.name} km={t.km} href={`/${t.slug}`} /></li>)}</ul>
    </section>
  )}
</div>

<style>
  .plans { margin-top: var(--space-5); }
  .plans h2 { margin-bottom: var(--space-3); }
  .plans__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.6rem; max-width: 40rem; }
  .plan { display: grid; grid-template-columns: 4.5rem 1fr; gap: 0.8rem; align-items: center; padding: 0.55rem; border: 1px solid var(--line); border-radius: var(--radius); text-decoration: none; color: inherit; }
  .plan:hover { border-color: var(--sign-green); }
  .plan__img { width: 4.5rem; height: 4.5rem; border-radius: calc(var(--radius) * 0.7); object-fit: cover; display: block; }
  .plan__img--none { background: var(--sign-green); }
  .plan__text { display: grid; gap: 0.15rem; min-width: 0; }
  .plan__kind { font: 700 0.78rem/1.2 var(--font-display); text-transform: uppercase; letter-spacing: 0.04em; color: var(--sign-green); }
  .plan__title { font: 800 1.08rem/1.2 var(--font-display); }
  .plan__line { font-size: 0.9rem; color: var(--muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .plans__tb { margin-top: var(--space-3); font-family: var(--font-display); font-weight: 700; }
  .plans__tb a { color: var(--sign-green); }
</style>
