---
import RoadSign from '../../components/vic/RoadSign.astro';
import PlaceRow from '../../components/vic/PlaceRow.astro';
import AffiliateLink from '../../components/vic/AffiliateLink.astro';
import { GROUP_LABEL, TYPE_LABEL, type Group, type Place } from '../../../brands/vic/model';
interface Props {
  town: { name: string; slug: string; km: number };
  group: Group;
  places: Place[];
  affiliates?: Record<string, any> | null;
  placePhotos?: Record<string, any>;
  total?: number;
  guide?: string[];
  townNames?: Record<string, string>;
}
const { town, group, places, affiliates = null, placePhotos = {}, guide = [], townNames = {} } = Astro.props;
const total = Astro.props.total ?? places.length;
const has = (k: string) => places.filter((p) => (k === 'dog' ? ['yes', 'leashed'].includes(p.tags.dog) : k === 'outdoor' ? p.tags.outdoor_seating === 'yes' : k === 'access' ? p.tags.wheelchair === 'yes' : !!p.tags.opening_hours)).length;
const situations = [
  { key: 'dog', label: 'Dogs welcome' },
  { key: 'outdoor', label: 'Outdoor seating' },
  { key: 'access', label: 'Wheelchair accessible' },
  { key: 'hours', label: 'Hours listed' },
].map((s) => ({ ...s, n: has(s.key) })).filter((s) => s.n > 0);
const types = Object.entries(places.reduce<Record<string, number>>((a, p) => ((a[p.type] = (a[p.type] ?? 0) + 1), a), {})).sort((a, b) => b[1] - a[1]);
---
<div class="wrap town">
  <p class="crumb"><a href={`/${town.slug}`}>{town.name}</a></p>
  <RoadSign name={town.name} km={town.km} tone={group === 'do' ? 'brown' : 'green'} />
  <h1 class="page-title">{GROUP_LABEL[group].title(town.name)}</h1>
  {guide.map((para) => <p class="town__body">{para}</p>)}
  <p class="count">{total > places.length ? `The ${places.length} best-documented of ${total.toLocaleString('en-AU')} ${GROUP_LABEL[group].noun}.` : `${places.length} ${GROUP_LABEL[group].noun}, best-documented first.`}</p>
  {group === 'stay' && <AffiliateLink aff={affiliates?.stay} place={town.name} kind="stay" />}
  {group === 'do' && <AffiliateLink aff={affiliates?.tours} place={town.name} kind="tours" />}
  {types.length > 1 && (
    <div class="filters" role="group" aria-label="Filter by type">
      <button type="button" aria-pressed="true" data-filter="">All <span>{places.length}</span></button>
      {types.map(([t, n]) => <button type="button" aria-pressed="false" data-filter={t}>{TYPE_LABEL[t] ?? t} <span>{n}</span></button>)}
    </div>
  )}
  {situations.length > 0 && (
    <div class="filters filters--situations" role="group" aria-label="Only show places that are">
      {situations.map((s) => <button type="button" aria-pressed="false" data-flag={s.key}>{s.label} <span>{s.n}</span></button>)}
    </div>
  )}
  <p class="count" data-shown hidden></p>
  <ul class="places" data-places>{places.map((p) => <PlaceRow place={p} photo={placePhotos[p.id]} townName={townNames[p.town]} townSlug={p.town} />)}</ul>
  <p class="more"><a href={`/${town.slug}`}>Back to {town.name}: stay, eat and do</a></p>
</div>
<script is:inline>
  (function () {
    var list = document.querySelector('[data-places]');
    var shown = document.querySelector('[data-shown]');
    var buttons = document.querySelectorAll('[data-filter]');
    var flags = document.querySelectorAll('[data-flag]');
    var type = '', need = {};
    function apply() {
      var n = 0;
      Array.prototype.forEach.call(list.children, function (li) {
        var f = ' ' + (li.getAttribute('data-flags') || '') + ' ';
        var ok = (!type || li.getAttribute('data-type') === type) && Object.keys(need).every(function (k) { return f.indexOf(' ' + k + ' ') !== -1; });
        li.hidden = !ok; if (ok) n++;
      });
      var filtered = type || Object.keys(need).length;
      shown.hidden = !filtered;
      shown.textContent = n ? 'Showing ' + n + (n === 1 ? ' place' : ' places') : 'Nothing matches all of those. Try removing a filter.';
    }
    buttons.forEach(function (b) {
      b.addEventListener('click', function () {
        type = b.getAttribute('data-filter');
        buttons.forEach(function (x) { x.setAttribute('aria-pressed', String(x === b)); });
        apply();
      });
    });
    flags.forEach(function (b) {
      b.addEventListener('click', function () {
        var k = b.getAttribute('data-flag');
        if (need[k]) delete need[k]; else need[k] = true;
        b.setAttribute('aria-pressed', String(!!need[k]));
        apply();
      });
    });
  })();
</script>
