---
import BookCta from './BookCta.astro';
interface Props { book: string; title: string; paragraphs: string[]; showCta?: boolean }
const { book, title, paragraphs, showCta = false } = Astro.props;
---
<section class="chc-pagehead"><div class="chc-wrap"><h1>{title}</h1></div></section>
<div class="chc-wrap chc-section chc-prose">{paragraphs.map((p) => <p>{p}</p>)}</div>
{showCta && <BookCta book={book} />}
