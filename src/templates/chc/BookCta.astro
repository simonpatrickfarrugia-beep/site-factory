---
/** The one call to action, everywhere: email Simon for a free chat, or use the contact form. */
interface Props { book: string; heading?: string; text?: string }
const { book, heading = 'Start with a free chat', text = 'Send a quick email and we will set up a relaxed video call about what you want to change. No cost, no commitment.' } = Astro.props;
---
<section class="chc-cta">
  <div class="chc-wrap chc-cta__inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <p class="chc-cta__actions">
      <a class="chc-btn" href={book} data-cta="email_chat">Email Simon for a free chat</a>
      <a class="chc-link" href="/contact">Or use the contact form</a>
    </p>
  </div>
</section>
