---
import BookCta from './BookCta.astro';
interface Props { book: string; title: string; lede: string; steps: { t: string; d: string }[]; sections?: { h: string; p: string[] }[] }
const { book, title, lede, steps, sections = [] } = Astro.props;
---
<section class="chc-pagehead">
  <div class="chc-wrap">
    <h1>{title}</h1>
    <p class="chc-lede">{lede}</p>
  </div>
</section>
<section class="chc-section chc-wrap">
  <ol class="chc-steps chc-steps--big">{steps.map((st) => <li><h2>{st.t}</h2><p>{st.d}</p></li>)}</ol>
</section>
{sections.length > 0 && (
  <section class="chc-wrap chc-section chc-section--tight chc-prose">
    {sections.map((sec) => <><h2 class="chc-h2">{sec.h}</h2>{sec.p.map((para) => <p>{para}</p>)}</>)}
  </section>
)}
<BookCta book={book} />
