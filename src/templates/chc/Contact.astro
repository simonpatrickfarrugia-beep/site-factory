---
interface Props { calendly: string; email: string; endpoint: string; services: { slug: string; name: string }[] }
const { calendly, email, endpoint, services } = Astro.props;
const noHealth = "Please don't include health details, NDIS numbers or dates of birth. We'll talk about that privately.";
---
<section class="chc-pagehead">
  <div class="chc-wrap">
    <h1>Get in touch</h1>
    <p class="chc-lede">The quickest way to start is a free chat. Or send a message and Simon will email you back.</p>
    <p class="chc-hero__actions">
      <a class="chc-btn" href={calendly} target="_blank" rel="noopener" data-cta="book_chat">Book a free chat</a>
      <a class="chc-link" href={`mailto:${email}`}>{email}</a>
    </p>
  </div>
</section>

<div class="chc-wrap chc-section chc-forms">
  <section id="enquire">
    <h2 class="chc-h2">Send an enquiry</h2>
    <form class="chc-form" data-form action={`${endpoint}/submit/enquiry`} method="post">
      <label>Your name<input name="name" autocomplete="name" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Phone <span class="chc-opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      <fieldset>
        <legend>Who is the support for?</legend>
        <label class="chc-choice"><input type="radio" name="for" value="me" required /> Me</label>
        <label class="chc-choice"><input type="radio" name="for" value="someone I support" /> Someone I support</label>
        <label class="chc-choice"><input type="radio" name="for" value="I'm a coordinator or plan manager" /> I'm a coordinator or plan manager</label>
      </fieldset>
      <label>Service you're interested in
        <select name="service"><option value="">Not sure yet</option>{services.map((s) => <option value={s.name}>{s.name}</option>)}</select>
      </label>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <p class="chc-hint">{noHealth}</p>
      <input class="chc-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="chc-btn" type="submit">Send enquiry</button>
      <p class="chc-form__status" role="status" aria-live="polite"></p>
    </form>
  </section>

  <section id="refer">
    <h2 class="chc-h2">Refer someone</h2>
    <p>For support coordinators, plan managers and families. Just the basics; we'll take it from there.</p>
    <form class="chc-form" data-form action={`${endpoint}/submit/referral`} method="post">
      <label>Your name<input name="referrer_name" autocomplete="name" required /></label>
      <label>Organisation <span class="chc-opt">(optional)</span><input name="organisation" autocomplete="organization" /></label>
      <label>Your email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Your phone <span class="chc-opt">(optional)</span><input name="phone" type="tel" autocomplete="tel" /></label>
      <label>Participant's first name<input name="participant_first_name" required /></label>
      <label>Service
        <select name="service"><option value="">Not sure yet</option>{services.map((s) => <option value={s.name}>{s.name}</option>)}</select>
      </label>
      <label>Best way to contact the participant (or you)<input name="best_contact" placeholder="e.g. call me first, or email the participant" /></label>
      <p class="chc-hint">{noHealth}</p>
      <input class="chc-hp" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <button class="chc-btn" type="submit">Send referral</button>
      <p class="chc-form__status" role="status" aria-live="polite"></p>
    </form>
  </section>
</div>

<script is:inline define:vars={{ email }}>
  document.querySelectorAll('form[data-form]').forEach(function (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var status = form.querySelector('.chc-form__status');
      var button = form.querySelector('button[type=submit]');
      button.disabled = true;
      status.textContent = 'Sending…';
      fetch(form.action, { method: 'POST', body: new FormData(form) })
        .then(function (r) { if (!r.ok) throw new Error(String(r.status)); return r.json(); })
        .then(function () {
          form.reset();
          status.textContent = 'Sent. Simon will email you back soon.';
          if (window.gtag) window.gtag('event', 'cta_' + form.action.split('/').pop());
        })
        .catch(function () { status.textContent = "That didn't send. Please email " + email + ' instead.'; })
        .finally(function () { button.disabled = false; });
    });
  });
</script>
