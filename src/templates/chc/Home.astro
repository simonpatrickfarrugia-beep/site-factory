---
import NoteCard from './NoteCard.astro';
import BookCta from './BookCta.astro';
interface Props {
  book: string;
  hero: { title: string; lede: string; note: any };
  audiences: { t: string; d: string; href?: string; link?: string }[];
  services: { slug: string; name: string; short: string }[];
  steps: { t: string; d: string }[];
  testimonials: { quote: string; name: string; context: string }[];
  faqs: { q: string; a: string }[];
}
const { book, hero, audiences, services, steps, testimonials, faqs } = Astro.props;
---
<section class="chc-hero">
  <div class="chc-wrap chc-hero__grid">
    <div class="chc-hero__text">
      <h1>{hero.title}</h1>
      <p class="chc-lede">{hero.lede}</p>
      <p class="chc-hero__actions">
        <a class="chc-btn" href={book} data-cta="email_chat">Email Simon for a free chat</a>
        <a class="chc-link" href="/how-it-works">How it works</a>
      </p>
      <p class="chc-small">Sessions are online on Microsoft Teams. NDIS (self-managed and plan-managed) or private.</p>
    </div>
    <NoteCard note={hero.note} />
  </div>
</section>

<section class="chc-section chc-wrap">
  <h2 class="chc-h2">What we help with</h2>
  <ul class="chc-services">
    {services.map((s) => (
      <li>
        <a href={`/${s.slug}`}><h3>{s.name}</h3></a>
        <p>{s.short}</p>
      </li>
    ))}
  </ul>
</section>

<section class="chc-section chc-band">
  <div class="chc-wrap">
    <h2 class="chc-h2">How it works</h2>
    <ol class="chc-steps">
      {steps.map((st) => <li><h3>{st.t}</h3><p>{st.d}</p></li>)}
    </ol>
  </div>
</section>

<section class="chc-section chc-wrap">
  <h2 class="chc-h2">Who it's for</h2>
  <div class="chc-audiences">
    {audiences.map((a) => (
      <div>
        <h3>{a.t}</h3>
        <p>{a.d}</p>
        {a.href && <p><a class="chc-link" href={a.href}>{a.link}</a></p>}
      </div>
    ))}
  </div>
</section>

{testimonials.length > 0 && (
  <section class="chc-section chc-wrap">
    <h2 class="chc-h2">In their words</h2>
    {testimonials.map((t) => <blockquote class="chc-quote"><p>{t.quote}</p><footer>{t.name}, {t.context}</footer></blockquote>)}
  </section>
)}

<section class="chc-section chc-band">
  <div class="chc-wrap chc-freebie">
    <img src="/downloads/journal-page-preview.webp" width="350" height="497" alt="" loading="lazy" />
    <div>
      <h2 class="chc-h2">Free: the daily journal Simon uses</h2>
      <p>Five minutes in the morning, five at night: gratitude, three actions for the day, and a short evening review. 90 days of printable pages, no sign-up.</p>
      <p><a class="chc-btn" href="/free-daily-journal">Get the free journal</a></p>
    </div>
  </div>
  <div class="chc-wrap chc-freebie chc-freebie--tool">
    <svg viewBox="0 0 120 160" width="120" height="160" aria-hidden="true"><rect x="4" y="4" width="112" height="152" rx="8" fill="#fff" stroke="#123B30" stroke-width="4"/><rect x="18" y="20" width="60" height="10" rx="3" fill="#123B30"/><rect x="18" y="36" width="40" height="6" rx="3" fill="#9EF5CF"/><g fill="#CFE9DE"><rect x="18" y="56" width="84" height="5" rx="2"/><rect x="18" y="66" width="76" height="5" rx="2"/><rect x="18" y="86" width="84" height="5" rx="2"/><rect x="18" y="96" width="70" height="5" rx="2"/><rect x="18" y="106" width="80" height="5" rx="2"/><rect x="18" y="126" width="60" height="5" rx="2"/></g></svg>
    <div>
      <h2 class="chc-h2">Free: build your resume</h2>
      <p>An Australian-format resume in minutes, with tips for first jobs and career gaps. Save it as a PDF. No sign-up, and what you type never leaves your device.</p>
      <p><a class="chc-btn" href="/resume-builder">Build my resume</a> <a class="chc-link" href="/cover-letter-builder">Or write a cover letter</a></p>
      <p>Looking for work that fits around your life? Try the <a class="chc-link" href="/job-finder">part-time and flexible job finder</a>.</p>
    </div>
  </div>
</section>

<section class="chc-section chc-wrap">
  <h2 class="chc-h2">Common questions</h2>
  <div class="chc-faq">
    {faqs.map((f) => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
  </div>
  <p><a class="chc-link" href="/faq">All questions</a></p>
</section>

<BookCta book={book} />
