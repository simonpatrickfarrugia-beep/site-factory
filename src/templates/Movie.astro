---
import TrailerScreen from '../components/TrailerScreen.astro';
import MovieCard from '../components/MovieCard.astro';
import FreeFilmPlayer from '../components/FreeFilmPlayer.astro';
import { basisLine, type FreeFilm } from '../../brands/trailers/public-domain';
import type { Movie } from '../../brands/trailers/model';

interface Props {
  movie: Movie;
  inCollections: { slug: string; name: string; count: number }[];
  related: { slug: string; name: string; year: string | null; youtubeId: string }[];
  byDirector?: { slug: string; name: string; year: string | null; youtubeId: string }[];
  genre: string | null;
  amazonTag: string;
  /** Public domain in the US: the full film plays on this page (brands/trailers/public-domain.ts). */
  free?: FreeFilm | null;
  /** Public domain from a future 1 January: shown as "free here from …", no film and no stills until then. */
  upcoming?: { freeOn: string } | null;
  /** Another version of this film that is free here (e.g. the 1922 original on the 2024 remake's page). */
  original?: { slug: string; name: string; year: string; freeOn?: string | null } | null;
  /** Other free films, shown on free films' pages. */
  moreFree?: { slug: string; name: string; year: string; image: string }[];
}
const { movie: m, inCollections, related, byDirector = [], genre, amazonTag, free = null, upcoming = null, original = null, moreFree = [] } = Astro.props;

const runtime = m.runtimeMinutes
  ? `${Math.floor(m.runtimeMinutes / 60)}h ${String(m.runtimeMinutes % 60).padStart(2, '0')}m`
  : null;
const facts = [
  { label: 'Released', value: m.year },
  { label: 'Rated', value: m.rating },
  { label: 'Runtime', value: runtime },
  { label: 'Directed by', value: m.director },
  { label: 'Starring', value: m.cast.join(', ') || null },
  { label: 'Genre', value: m.genres.join(', ') || null },
  { label: 'Box office', value: m.boxOffice },
  { label: 'Sound', value: free ? (free.audio === 'silent' ? 'Silent film' : 'Original soundtrack') : null },
  { label: 'Subtitles', value: free?.media?.subtitles?.length ? free.media.subtitles.map((t) => t.label).join(', ') : null },
].filter((f) => f.value);
const withYear = `${m.name} ${m.year ?? ''}`.trim();
const tagAmazon = (url: string) => {
  try {
    const u = new URL(url);
    if (/(^|\.)amazon\./i.test(u.hostname)) u.searchParams.set('tag', amazonTag);
    return u.toString();
  } catch {
    return url;
  }
};
// Prime Video first: digital rentals/purchases earn 5% in Amazon Associates (US), DVD/Blu-ray 2.5%.
// i=instant-video searches Prime Video; i=movies-tv searches discs. Both carry the tracking tag.
const amazonSearch = (dept: 'instant-video' | 'movies-tv') =>
  `https://www.amazon.com/s?k=${encodeURIComponent(withYear)}&i=${dept}&tag=${amazonTag}`;
const primeUrl = m.rentBuyUrl ? tagAmazon(m.rentBuyUrl) : amazonSearch('instant-video');
const discUrl = amazonSearch('movies-tv');
const justWatchUrl = `https://www.justwatch.com/us/search?q=${encodeURIComponent(m.name)}`;

// "Is it worth watching?": plain answers built only from facts we hold (IMDb score, US rating, runtime,
// box office). No invented opinions; streaming services aren't named as having it, because we don't track that.
const r = typeof m.imdbRating === 'number' ? m.imdbRating : null;
const g = (m.genres[0] ?? 'this kind of film').toLowerCase();
const verdict =
  r === null ? null
  : r >= 8 ? `Yes. It's rated ${r}/10 on IMDb, which puts it among the best-reviewed films there. A safe pick if you haven't seen it.`
  : r >= 7 ? `Most people think so. It holds ${r}/10 on IMDb, a strong score.`
  : r >= 6 ? `It splits opinion: ${r}/10 on IMDb. Worth it if you enjoy ${g} films.`
  : `Reviews are mixed (${r}/10 on IMDb), so watch the trailer above first and decide.`;
const gross = Number((m.boxOffice ?? '').replace(/[^0-9]/g, '')) || 0;
const hit = gross >= 100_000_000 ? ` It was a big hit too, taking ${m.boxOffice} at the US box office.` : '';
const length = m.runtimeMinutes
  ? `${runtime}${m.runtimeMinutes < 95 ? ': a short one, easy for a weeknight.' : m.runtimeMinutes <= 130 ? ': a standard movie-night length.' : m.runtimeMinutes <= 150 ? ': on the long side, so start early.' : ': a long one. Settle in for the evening.'}`
  : null;
const ratings: Record<string, string> = {
  G: 'Rated G in the US: fine for all ages.',
  PG: 'Rated PG in the US: fine for most kids, though some scenes may need a parent nearby.',
  'PG-13': 'Rated PG-13 in the US: better for teens; some material may not suit under-13s.',
  R: 'Rated R in the US: for adults, or under-17s with a parent.',
  'NC-17': 'Rated NC-17 in the US: adults only.',
};
const kids = m.rating ? ratings[m.rating] ?? null : null;
const faq = [
  verdict && { q: `Is ${m.name} worth watching?`, a: verdict + hit },
  length && { q: `How long is ${m.name}?`, a: length },
  kids && { q: `Is ${m.name} OK for kids?`, a: kids },
  free && { q: `Is it legal to watch ${m.name} free?`, a: `Yes, in the United States. ${basisLine(free)} We only play it to US visitors because copyright rules differ between countries, and we show the plain original, never a restored or re-scored version.` },
  upcoming && { q: `When can I watch ${m.name} free?`, a: `From ${upcoming.freeOn}, when it enters the public domain in the United States. It will play in full on this page from that day.` },
  free
    ? { q: `Where can I stream ${m.name}?`, a: `Right here, free, if you're in the US (player above). For a sharper restored copy, rent or buy it on Prime Video or Blu-ray.` }
    : { q: `Where can I stream ${m.name}?`, a: `You can rent or buy it on Prime Video in the US (button above). For subscription services, JustWatch shows where it's streaming today, since that changes month to month.` },
].filter(Boolean) as { q: string; a: string }[];
---
<article class="movie">
  {free ? (
    <div class="movie__screen"><FreeFilmPlayer archiveId={free.archiveId} name={m.name} src={free.media ? `/media/${free.media.file}` : null} silent={free.audio === 'silent'} tracks={(free.media?.subtitles ?? []).map((t) => ({ src: `/media/${t.file}`, lang: t.lang, label: t.label }))} /></div>
  ) : m.youtubeId ? (
    <div class="movie__screen"><TrailerScreen youtubeId={m.youtubeId} title={m.name} priority /></div>
  ) : null}

  <div class="wrap">
    <header class="movie__head">
      <h1 class="marquee">
        <span class="marquee__kicker">{free ? 'Watch free: full movie' : 'Where to watch'}</span>
        <span class="marquee__title">{m.name}</span>
        {m.year && <span class="marquee__year">{m.year}</span>}
      </h1>
      {m.tagline && <p class="movie__tagline">{m.tagline}</p>}
    </header>


    <div class="movie__body">
      <div class="movie__story prose">
        {(m.summary || m.synopsis) && <p class="lede">{m.summary || m.synopsis}</p>}
        {free?.watchIf && <p><strong>Watch it if</strong> {free.watchIf}</p>}
        <section class="watch" aria-labelledby="watch-heading">
          <h2 id="watch-heading">{free ? 'Prefer it restored and in HD? Rent or buy it' : 'Rent, buy or stream it'}</h2>
          <p class="button-row">
            <a class="button" href={primeUrl} rel="sponsored noopener" target="_blank" data-cta="prime" aria-label={`Watch ${m.name} now on Prime Video`}>Watch now <span class="button__via">on Prime Video</span></a>
            <a class="button button--quiet" href={discUrl} rel="sponsored noopener" target="_blank" data-cta="disc">Buy on DVD &amp; Blu-ray</a>
            <a class="button button--quiet" href={justWatchUrl} rel="noopener" target="_blank" data-cta="justwatch">Where else to stream</a>
          </p>
        </section>

        {upcoming && (
          <section class="free-film" aria-labelledby="free-heading">
            <h2 id="free-heading">Free to watch here from {upcoming.freeOn}</h2>
            <p>{m.name} ({m.year}) enters the public domain in the United States on {upcoming.freeOn}. From that day the full film plays free on this page for US visitors. Bookmark it, or browse the <a href="/free-classic-movies">free classic movies</a> you can watch today.</p>
          </section>
        )}

        {original && (
          <section class="free-film" aria-labelledby="original-heading">
            <h2 id="original-heading">{original.freeOn ? `The ${original.year} original: free here from ${original.freeOn}` : `Watch the ${original.year} original free`}</h2>
            <p><a href={`/movies/${original.slug}`}>{original.name} ({original.year})</a> {original.freeOn ? 'enters the US public domain soon, and will play in full on its page.' : 'is in the public domain in the US: the full film plays free on its page.'}</p>
          </section>
        )}

        {free && m.youtubeId && (
          <section aria-labelledby="trailer-heading">
            <h2 id="trailer-heading">Trailer</h2>
            <TrailerScreen youtubeId={m.youtubeId} title={m.name} />
          </section>
        )}

        {free && (
          <section class="free-film" aria-labelledby="rights-heading">
            <h2 id="rights-heading">Why is it free?</h2>
            <p>{basisLine(free)}</p>
            <ul>{free.evidence.map((e) => <li><a href={e.url} rel="noopener" target="_blank">{e.label}</a></li>)}</ul>
            <p class="free-film__small">{free.media ? `Copied from the Internet Archive, a non-profit library${free.media.audio === 'removed' ? ', with the soundtrack an uploader added removed, so you see the film as it was released' : ''}.` : 'Plays from the Internet Archive, a non-profit library.'} Verified {free.audit.checkedOn} and re-verified every week. Rights enquiries: <a href={`mailto:hello@movietrailer.channel?subject=${encodeURIComponent(`Rights enquiry: ${m.name}`)}`}>hello@movietrailer.channel</a>.</p>
          </section>
        )}



        {faq.length > 1 && (
          <section class="worth" aria-labelledby="worth-heading">
            <h2 id="worth-heading">{verdict ? `Is ${m.name} worth watching?` : `${m.name}: your questions`}</h2>
            {faq.map((f, i) => (
              <div class="worth__item">
                {(i > 0 || !verdict) && <h3>{f.q}</h3>}
                <p>{f.a}</p>
              </div>
            ))}
          </section>
        )}
      </div>

      {facts.length > 0 && (
        <dl class="facts">
          {facts.map((f) => (
            <div class="facts__row">
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
    </div>

    {inCollections.length > 0 && (
      <section class="band" aria-labelledby="in-collections">
        <h2 id="in-collections">Also featured in</h2>
        <ul class="chip-list">
          {inCollections.map((c) => <li><a class="chip" href={c.href ?? `/discover/${c.slug}`}>{c.name}</a></li>)}
        </ul>
      </section>
    )}

    {byDirector.length > 0 && (
      <section class="band" aria-labelledby="by-director">
        <h2 id="by-director">More from {m.director}</h2>
        <div class="grid grid--cards">
          {byDirector.map((r) => <MovieCard {...r} />)}
        </div>
      </section>
    )}

    {moreFree.length > 0 && (
      <section class="band" aria-labelledby="more-free">
        <h2 id="more-free">More free classic movies</h2>
        <div class="grid grid--cards">
          {moreFree.map((r) => <MovieCard slug={r.slug} name={r.name} year={r.year} youtubeId="" image={r.image} badge="Watch free" />)}
        </div>
        <p><a href="/free-classic-movies">All free classic movies →</a></p>
      </section>
    )}

    {related.length > 0 && (
      <section class="band" aria-labelledby="related">
        <h2 id="related">More {genre?.toLowerCase()} trailers</h2>
        <div class="grid grid--cards">
          {related.map((r) => <MovieCard {...r} />)}
        </div>
      </section>
    )}
  </div>
</article>
