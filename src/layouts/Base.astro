---
import { brand } from '../lib/brand';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Page title. Brand suffix is added unless rawTitle is true. Omit for the brand name alone. */
  title?: string;
  rawTitle?: boolean;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>[];
}

const { title, rawTitle = false, description = brand.seo.defaultDescription, image, schema = [] } = Astro.props;
const fullTitle = !title ? brand.name : rawTitle ? title : `${title}${brand.seo.titleSuffix}`;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).toString();
// Google Fonts rejects the whole request if a family lacks a requested weight,
// so ask only for weights every family on the list is likely to have.
const fontQuery = [
  `family=${brand.fonts.display.replace(/ /g, '+')}:wght@700;800`,  // display font must offer 700 and 800
  `family=${brand.fonts.body.replace(/ /g, '+')}:wght@400;600;700`,
].join('&');
const tokens = {
  '--color-brand': brand.colors.brand,
  '--color-accent': brand.colors.accent,
  '--font-display': `'${brand.fonts.display}', 'Arial Narrow', sans-serif`,
  '--font-body': `'${brand.fonts.body}', system-ui, sans-serif`,
};
const tokenCss = `:root{${Object.entries(tokens).map(([k, v]) => `${k}:${v}`).join(';')}}`;
---
<!doctype html>
<html lang="en" data-theme={brand.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {!brand.launched && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content={brand.colors.brand} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontQuery}&display=swap`} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <style is:inline set:html={tokenCss}></style>

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {brand.analytics.ga4Id && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${brand.analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: brand.analytics.ga4Id }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
          // Count clicks on call-to-action links (data-cta="prime" etc.) as GA4 events named cta_<name>,
          // e.g. cta_prime. Event name x page path gives clicks per page without any GA4 custom-dimension setup.
          document.addEventListener('click', function (e) {
            var a = e.target instanceof Element ? e.target.closest('a[data-cta]') : null;
            if (!a) return;
            var cta = String(a.getAttribute('data-cta') || 'link').toLowerCase().replace(/[^a-z0-9_]/g, '_').slice(0, 30);
            gtag('event', 'cta_' + cta, {
              cta: cta,
              sponsored: /\bsponsored\b/.test(a.getAttribute('rel') || ''),
              link_domain: a.hostname,
              transport_type: 'beacon',
            });
          });
        </script>
      </>
    )}
    {brand.analytics.cloudflareToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: brand.analytics.cloudflareToken })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
