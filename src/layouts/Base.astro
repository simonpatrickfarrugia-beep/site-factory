---
import { brand } from '../lib/brand';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  /** Page title. Brand suffix is added unless rawTitle is true. Omit for the brand name alone. */
  title?: string;
  rawTitle?: boolean;
  description?: string;
  image?: string;
  schema?: Record<string, unknown>[];
  /** Private page: noindex and no analytics. */
  private?: boolean;
  /** Public page kept out of Google for now (thin): noindex, follow. Analytics still on. */
  noindex?: boolean;
}

const { title, rawTitle = false, description = brand.seo.defaultDescription, image, schema = [], private: isPrivate = false, noindex = false } = Astro.props;
const fullTitle = !title ? brand.name : rawTitle ? title : `${title}${brand.seo.titleSuffix}`;
// AdSense loads only on launched, public pages that aren't excluded (brand.ads.exclude).
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/') || '/';
const adsClient = brand.launched && !isPrivate && brand.ads.adsenseClient && !brand.ads.exclude.some((p) => path === p || path.startsWith(p + '/'))
  ? brand.ads.adsenseClient : null;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).toString();
// Google Fonts rejects the whole request if a family lacks a requested weight,
// so ask only for weights every family on the list is likely to have.
const fontQuery = [
  `family=${brand.fonts.display.replace(/ /g, '+')}:wght@700;800`,  // display font must offer 700 and 800
  `family=${brand.fonts.body.replace(/ /g, '+')}:wght@400;600;700`,
].join('&');
const tokens = {
  '--color-brand': brand.colors.brand,
  '--color-accent': brand.colors.accent,
  '--font-display': `'${brand.fonts.display}', 'Arial Narrow', sans-serif`,
  '--font-body': `'${brand.fonts.body}', system-ui, sans-serif`,
};
const tokenCss = `:root{${Object.entries(tokens).map(([k, v]) => `${k}:${v}`).join(';')}}`;
// "Give first" outreach: organisations featured on a page in IMN HQ show up at the bottom of that page.
// Loaded from the site Worker (/api/featured), so they appear within minutes, with no rebuild.
const FEATURED_HEADINGS: Record<string, string> = {
  vic: 'Local contacts',
  'community-help-co': 'Get help in person',
  'trade-admin': 'Useful contacts',
  trailers: 'Film groups we like',
};
const featuredHeading = brand.launched && !isPrivate ? FEATURED_HEADINGS[__BRAND__] ?? null : null;
---
<!doctype html>
<html lang="en" data-theme={brand.theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {(!brand.launched || isPrivate) && <meta name="robots" content="noindex, nofollow" />}
    {brand.launched && !isPrivate && noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content={brand.colors.brand} />
    {Object.entries(brand.verify ?? {}).map(([name, content]) => <meta name={name} content={content} value={content} />)}
    {brand.favicon && <link rel="icon" type={brand.favicon.endsWith('.svg') ? 'image/svg+xml' : 'image/png'} href={brand.favicon} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {(image || brand.shareImage) && <meta property="og:image" content={image ?? new URL(brand.shareImage!, Astro.site).toString()} />}
    <meta name="twitter:card" content={image || brand.shareImage ? 'summary_large_image' : 'summary'} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fontQuery}&display=swap`} />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <style is:inline set:html={tokenCss}></style>

    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    {brand.analytics.ga4Id && !isPrivate && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${brand.analytics.ga4Id}`}></script>
        <script is:inline define:vars={{ ga4Id: brand.analytics.ga4Id }}>
          // Owner opt-out: visit any page with ?notrack=1 once per browser/device (each site separately) and GA4
          // ignores that device from then on; ?notrack=0 turns counting back on. Works on any network, unlike an
          // IP filter. Uses GA's own switch (window['ga-disable-<id>']), set before the config call.
          (function () {
            try {
              var m = /[?&]notrack=([01])/.exec(location.search);
              if (m) {
                if (m[1] === '1') localStorage.setItem('imn_notrack', '1'); else localStorage.removeItem('imn_notrack');
                alert(m[1] === '1' ? 'Analytics off for this browser on this site. Your visits won’t be counted.' : 'Analytics back on for this browser.');
              }
              if (localStorage.getItem('imn_notrack') === '1') window['ga-disable-' + ga4Id] = true;
            } catch (x) {}
          })();
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', ga4Id);
          // Count clicks on call-to-action links (data-cta="prime" etc.) as GA4 events named cta_<name>,
          // e.g. cta_prime. Event name x page path gives clicks per page without any GA4 custom-dimension setup.
          document.addEventListener('click', function (e) {
            var a = e.target instanceof Element ? e.target.closest('a[data-cta]') : null;
            if (!a) return;
            var cta = String(a.getAttribute('data-cta') || 'link').toLowerCase().replace(/[^a-z0-9_]/g, '_').slice(0, 30);
            gtag('event', 'cta_' + cta, {
              cta: cta,
              sponsored: /\bsponsored\b/.test(a.getAttribute('rel') || ''),
              link_domain: a.hostname,
              transport_type: 'beacon',
            });
          });
        </script>
      </>
    )}
    {brand.ads.adsenseClient && <meta name="google-adsense-account" content={brand.ads.adsenseClient} />}
    {adsClient && (
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsClient}`} crossorigin="anonymous"></script>
    )}
    {brand.analytics.cloudflareToken && !isPrivate && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: brand.analytics.cloudflareToken })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
      {featuredHeading && (
        <aside class="wrap featured" id="featured" aria-labelledby="featured-h" hidden>
          <h2 id="featured-h">{featuredHeading}</h2>
          <ul></ul>
        </aside>
      )}
    </main>
    <Footer />
      <script is:inline>
      // Spam trap for our forms: stamp each /api form with the time the page loaded. The site Worker quietly drops
      // posts with no stamp or sent within 3 seconds (bots post straight to the endpoint or fill forms instantly).
      (function () {
        var t = String(Date.now());
        document.querySelectorAll('form[action^="/api/"]').forEach(function (f) {
          var i = document.createElement('input'); i.type = 'hidden'; i.name = '_t'; i.value = t; f.appendChild(i);
        });
      })();
    </script>
    {featuredHeading && (
      <script is:inline>
      (function () {
        var box = document.getElementById('featured'); if (!box || !window.fetch) return;
        fetch('/api/featured?path=' + encodeURIComponent(location.pathname)).then(function (r) { return r.ok ? r.json() : { items: [] }; }).then(function (d) {
          var items = (d && d.items) || []; if (!items.length) return;
          var ul = box.querySelector('ul');
          items.forEach(function (i) {
            var li = document.createElement('li'); var a = document.createElement('a');
            a.href = i.url; a.textContent = i.name; a.rel = 'noopener'; li.appendChild(a);
            if (i.blurb) { var s = document.createElement('span'); s.textContent = ' ' + i.blurb; li.appendChild(s); }
            ul.appendChild(li);
          });
          box.hidden = false;
        }).catch(function () {});
      })();
      </script>
    )}
  </body>
</html>
