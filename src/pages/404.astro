---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" description="This page doesn't exist.">
  <div class="wrap">
    <div class="page prose">
      <h1 class="display">Nothing showing here</h1>
      <p>This page doesn't exist, or the trailer has been taken down.</p>
      <p class="button-row">
        <a class="button" href="/browse">Browse all trailers</a>
        <a class="button button--quiet" href="/">Go to the home page</a>
      </p>
    </div>
  </div>
</Base>
