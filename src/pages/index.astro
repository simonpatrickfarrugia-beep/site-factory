---
import Base from '../layouts/Base.astro';
import { brand } from '../lib/brand';
---
<Base>
  <h1>{brand.name}</h1>
  <p>The site factory is live for this brand. This placeholder proves the build and deploy pipeline works.</p>
  <ul>
    <li>Brand: <strong>{brand.slug}</strong></li>
    <li>Theme: <strong>{brand.theme}</strong></li>
    <li>Indexing: <strong>{brand.launched ? 'on' : 'off (preview)'}</strong></li>
  </ul>
</Base>
